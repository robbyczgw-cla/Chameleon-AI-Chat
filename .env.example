# =============================================================================
# Chameleon AI Chat - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project: https://supabase.com/dashboard
# Project Settings > API > Project URL and anon/public key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# RECOMMENDED: OpenRouter API (AI Models)
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
# This powers all AI chat functionality (100+ models available)

# Server-side fallback (optional - users can also enter their own key in Settings)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# Client-side key (optional - allows client-side API calls)
# NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Web Search APIs
# -----------------------------------------------------------------------------
# Enable AI-powered web search. Get keys from respective providers.
# Users can also configure these in Settings > API Keys

# Tavily AI Search: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key

# Serper Google Search: https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Exa Neural Search: https://exa.ai
EXA_API_KEY=your-exa-api-key

# You.com Search (optional): https://you.com/search/api
# NEXT_PUBLIC_YOUCOM_API_KEY=your-youcom-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: OpenAI (Voice & Image Generation)
# -----------------------------------------------------------------------------
# Required for Whisper voice transcription and DALL-E image generation
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Weather API
# -----------------------------------------------------------------------------
# For weather tool functionality
# Get your API key from: https://www.weatherapi.com

WEATHER_API_KEY=your-weather-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Shopify Integration
# -----------------------------------------------------------------------------
# For Shopify product search and store integration

# SHOPIFY_STORE_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=your-shopify-access-token

# -----------------------------------------------------------------------------
# OPTIONAL: Application URLs
# -----------------------------------------------------------------------------
# Override default URLs for API referer headers

# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL: Enterprise Access Tier
# -----------------------------------------------------------------------------
# Configure enterprise email domain for special access tier
# Users with emails ending in this domain get "hifi" (enterprise) access tier
# Example: @yourcompany.com gives all company employees enterprise features

# NEXT_PUBLIC_ENTERPRISE_EMAIL_DOMAIN=@yourcompany.com

# -----------------------------------------------------------------------------
# OPTIONAL: Development & Debug
# -----------------------------------------------------------------------------
# Enable verbose logging in production (not recommended)

# NEXT_PUBLIC_ENABLE_LOGGING=false

# -----------------------------------------------------------------------------
# CAPACITOR (Android Build Only)
# -----------------------------------------------------------------------------
# These are set automatically during Android builds - do not set manually

# CAPACITOR_BUILD=true
# CAPACITOR_SERVER_URL=https://your-production-url.vercel.app

{
  "name": "chameleon-ai-chat",
  "version": "1.1.0",
  "description": "Chameleon AI Chat - Adapt to any conversation style with 31 AI personas, real-time cost tracking, and 100+ AI models via OpenRouter",
  "author": "robbyczgw-cla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robbyczgw-cla/Chameleon-AI-Chat.git"
  },
  "bugs": {
    "url": "https://github.com/robbyczgw-cla/Chameleon-AI-Chat/issues"
  },
  "homepage": "https://github.com/robbyczgw-cla/Chameleon-AI-Chat#readme",
  "keywords": [
    "ai",
    "chat",
    "openrouter",
    "gpt-4",
    "claude",
    "personas",
    "cost-tracking",
    "next.js",
    "supabase"
  ],
  "private": false,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "pwa:check": "node scripts/pwa-smoke-check.mjs",
    "generate-icons": "node scripts/generate-icons.js",
    "cap:build": "CAPACITOR_BUILD=true next build",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:android:build": "npm run cap:build && npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:android:release": "npm run cap:build && npm run cap:sync && cd android && ./gradlew assembleRelease",
    "cap:android:run": "npx cap run android",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "cap:init": "npm run cap:build && npx cap add android && npm run cap:sync"
  },

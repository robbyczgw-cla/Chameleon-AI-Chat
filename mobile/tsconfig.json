{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@chameleon/shared": ["../shared"],
      "@chameleon/shared/*": ["../shared/*"]
    },
    "types": ["react-native", "jest"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}

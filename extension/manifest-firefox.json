{
  "manifest_version": 2,
  "name": "Chameleon AI",
  "version": "0.1.0",
  "description": "AI chat with 18+ personas, 100+ models. Highlight & Ask, Page Summarizer, Writing Assistant.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Chameleon AI"
  },
  "background": {
    "scripts": ["background/index.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject.js"],
      "css": ["content/styles.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "https://openrouter.ai/*",
    "https://api.openai.com/*"
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "web_accessible_resources": ["icons/*", "fonts/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "chameleon@chameleonai.chat",
      "strict_min_version": "109.0"
    }
  }
}
